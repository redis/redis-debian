#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk

ifneq ($(DEB_HOST_GNU_TYPE),$(DEB_BUILD_GNU_TYPE))
CC = $(DEB_HOST_GNU_TYPE)-gcc
export CC
else
# sbuild leaks CC=...-gcc on native builds; drop it so RediSearch picks clang-21.
unexport CC
endif

export CFLAGS CPPFLAGS LDFLAGS
export DEB_BUILD_MAINT_OPTIONS = hardening=+all,-format
export DEB_LDFLAGS_MAINT_APPEND = -ldl -latomic
export REDIS_CFLAGS='-Wno-error=uninitialized'
export CMAKE_POLICY_VERSION_MINIMUM=3.5
export BUILD_TLS = yes
export V = 1
DEB_BUILD_OPTIONS = nocheck

ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	MAKEFLAGS += -j$(NUMJOBS)
	export MAKEFLAGS
endif

%:
	dh $@

ARCH := $(shell dpkg --print-architecture)
$(info Host Architecture: $(ARCH))
TARGET_ARCH := $(DEB_HOST_ARCH)
$(info Target Architecture: $(TARGET_ARCH))

# Use TARGET_ARCH if we're in a cross-compilation environment
ifneq ($(ARCH),$(TARGET_ARCH))
    $(info Cross-compilation detected: $(ARCH) -> $(TARGET_ARCH))
    ARCH := $(TARGET_ARCH)
endif

ifeq ($(ARCH), amd64)
	WITH_MODULES = yes
else ifeq ($(ARCH), arm64)
	WITH_MODULES = yes
else ifeq ($(ARCH), i686)
	WITH_MODULES = no
else ifeq ($(ARCH), i386)
	WITH_MODULES = no
else ifeq ($(ARCH), armhf)
	WITH_MODULES = no
	export AR = arm-linux-gnueabihf-ar
else
    $(warning Unsupported architecture: '$(ARCH)')
endif

# Upstream defaults assume a foreground single-instance run; restore the values
# debian/conf-dist/redis.conf carried, matching conf-dist/sentinel.conf.
define debianize-conf
	sed -i \
		-e 's|^# supervised auto$$|supervised auto|' \
		-e 's|^pidfile /var/run/redis_6379\.pid$$|#pidfile /run/redis/redis-server.pid|' \
		-e 's|^logfile ""$$|logfile /var/log/redis/redis-server.log|' \
		-e 's|^dir \./$$|dir /var/lib/redis|' \
		redis.conf
	grep -qx 'supervised auto' redis.conf
	grep -qx 'logfile /var/log/redis/redis-server.log' redis.conf
	grep -qx 'dir /var/lib/redis' redis.conf
	! grep -qx 'pidfile .*' redis.conf
endef

override_dh_auto_install:
	debian/bin/generate-systemd-service-files
	cp debian/conf-dist/sentinel.conf ./sentinel.conf
ifeq ($(WITH_MODULES),yes)
	$(MAKE) deploy DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr/local
	# loadmodule lines must point at the final installed path, not the staging one.
	$(MAKE) sync-redis-conf PREFIX=/usr/lib/redis/modules ASSUME_BUILT=1
	mv -f redis-full.conf redis.conf
	$(debianize-conf)
else
	sed -i '/usr\/local\/lib\/redis\/modules\/\*\.so/d' debian/redis-server.install
	$(MAKE) deploy redis DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr/local
	$(MAKE) sync-redis-conf none
	mv -f redis-full.conf redis.conf
	$(debianize-conf)
endif

override_dh_auto_build:
ifeq ($(WITH_MODULES),yes)
	$(MAKE) -C modules install-rust INSTALL_RUST_TOOLCHAIN=yes
ifneq ($(DEB_HOST_GNU_TYPE),$(DEB_BUILD_GNU_TYPE))
	# Cross + modules: clang-21 is gated by <!cross>, so disable LTO.
	dh_auto_build -- LTO=0
else
	dh_auto_build
endif
else
	dh_auto_build -- build redis
endif

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# Avoid race conditions in upstream testsuite.
	./utils/gen-test-certs.sh
	./runtest --clients 1 --verbose --no-latency \
		--skiptest "diskless no replicas drop during rdb pipe" \
		--skiptest "diskless slow replicas drop during rdb pipe" \
		--skiptest "diskless fast replicas drop during rdb pipe" \
		--skiptest "diskless all replicas drop during rdb pipe"
	./runtest --clients 1 --tls --verbose --no-latency \
		--skiptest "diskless no replicas drop during rdb pipe" \
		--skiptest "diskless slow replicas drop during rdb pipe" \
		--skiptest "diskless fast replicas drop during rdb pipe" \
		--skiptest "diskless all replicas drop during rdb pipe"
	#./runtest-cluster --tls
	#./runtest-sentinel --tls
endif

override_dh_auto_clean:
	dh_auto_clean
	rm -f src/release.h debian/*.service
	rm -rf utils/tests
	rm -rf tests/tls
	rm -f tests/tmp/*

override_dh_compress:
	dh_compress -Xredis-trib.rb

override_dh_installchangelogs:
	dh_installchangelogs --keep 00-RELEASENOTES

override_dh_fixperms:
	# Do not allow dh_fixperms to "fix" modules so files perms as
	# it removes their x bit
	dh_fixperms -X/redis/modules
